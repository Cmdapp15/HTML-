
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>מוריד הסרטונים והמוזיקה האישי שלי</title>
    <!-- שימוש ב-Tailwind CSS לעיצוב יוקרתי ומודרני -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Rubik', sans-serif;
        }
    </style>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col justify-between">

    <!-- תוכן ראשי -->
    <main class="max-w-4xl w-full mx-auto px-4 py-8 flex-grow flex flex-col justify-center animate-fade-in">
        <!-- כותרת ראשית -->
        <div class="text-center mb-8">
            <span class="px-3 py-1 text-xs font-semibold tracking-wider text-emerald-400 bg-emerald-950/50 rounded-full border border-emerald-800/50">מצב תצוגה מקדימה (סימולטור פעיל)</span>
            <h1 class="text-4xl md:text-5xl font-black mt-3 bg-gradient-to-l from-emerald-400 to-teal-200 bg-clip-text text-transparent">YouTube Pro Downloader</h1>
            <p class="text-zinc-400 mt-2 text-sm md:text-base">הורדת סרטונים, מוזיקה וכתוביות באיכות גבוהה ישירות לתיקיית ההורדות במחשב</p>
        </div>

        <!-- התרעה על FFmpeg (תוצג רק אם חסר) -->
        <div id="ffmpeg-warning" class="hidden mb-6 p-4 bg-amber-950/40 border border-amber-900/50 rounded-2xl text-amber-300 text-sm flex items-start gap-3">
            <span class="text-xl">⚠️</span>
            <div>
                <strong class="font-bold">הערה חשובה:</strong> כלי המרת הוידאו <code class="bg-amber-900/50 px-1.5 py-0.5 rounded text-white">FFmpeg</code> לא זוהה במחשב. 
                <p class="mt-1 text-zinc-400 text-xs">תוכל להוריד וידאו באיכות רגילה ללא בעיה. כדי להוריד באיכות 1080p ומעלה או להמיר ל-MP3, הרץ בטרמינל השחור שלך: <code class="bg-zinc-900 text-amber-300 px-2 py-1 rounded">winget install Gyan.FFmpeg</code>.</p>
            </div>
        </div>

        <!-- כרטיסיית הממשק המרכזית -->
        <div class="bg-zinc-900/80 border border-zinc-800/80 rounded-2xl p-6 md:p-8 shadow-2xl backdrop-blur-md relative overflow-hidden">
            
            <!-- באנר מצב סימולציה מנצנץ ברקע -->
            <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-emerald-500 via-teal-400 to-emerald-500 animate-pulse"></div>

            <!-- שורת קלט של קישור -->
            <div class="space-y-2 mb-6">
                <label for="url-input" class="block text-sm font-medium text-zinc-300">הדבק כאן את הקישור מיוטיוב:</label>
                <div class="flex flex-col md:flex-row gap-3">
                    <input type="text" id="url-input" oninput="fetchVideoInfo()" placeholder="הדבק קישור (למשל הקישור של ה-Lo-Fi שלך) כדי לבדוק את הסימולטור..." 
                           class="flex-1 bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3.5 text-zinc-100 focus:outline-none focus:border-emerald-500 transition placeholder-zinc-600 text-left dir-ltr">
                </div>
                <p class="text-[11px] text-zinc-500">נסה להדביק את הקישור שלך: <span class="text-emerald-500/80 select-all cursor-pointer">https://youtu.be/eJ7V1svykpY</span></p>
            </div>

            <!-- תצוגה מקדימה דינמית של הסרטון (נטען לאחר הדבקת קישור) -->
            <div id="video-preview-card" class="hidden bg-zinc-950/60 p-4 border border-zinc-800/50 rounded-xl mb-6 flex flex-col md:flex-row gap-4 items-center">
                <img id="preview-thumb" src="" class="w-full md:w-40 h-24 object-cover rounded-lg border border-zinc-800 shadow">
                <div class="text-center md:text-right flex-1">
                    <h3 id="preview-title" class="font-bold text-zinc-100 text-base md:text-lg">שם הסרטון נטען...</h3>
                    <p id="preview-duration" class="text-xs text-zinc-500 mt-1">אורך: --:--</p>
                </div>
            </div>

            <!-- אפשרויות בחירת איכות ופורמט -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <!-- סוג הקובץ (פורמט) -->
                <div class="space-y-2">
                    <label class="block text-sm font-medium text-zinc-300">סוג ההורדה המבוקש:</label>
                    <div class="grid grid-cols-3 gap-2">
                        <button type="button" id="type-mp4" onclick="setFormat('mp4')" 
                                class="py-3 px-3 rounded-xl border border-emerald-500 bg-emerald-500/10 text-emerald-400 font-semibold text-xs md:text-sm text-center transition hover:bg-emerald-500/20">
                            🎬 וידאו (MP4)
                        </button>
                        <button type="button" id="type-mp3" onclick="setFormat('mp3')" 
                                class="py-3 px-3 rounded-xl border border-zinc-800 bg-zinc-950 text-zinc-400 font-semibold text-xs md:text-sm text-center transition hover:bg-zinc-900">
                            🎵 מוזיקה (MP3)
                        </button>
                        <button type="button" id="type-subs" onclick="setFormat('subs_only')" 
                                class="py-3 px-3 rounded-xl border border-zinc-800 bg-zinc-950 text-zinc-400 font-semibold text-xs md:text-sm text-center transition hover:bg-zinc-900">
                            📝 כתוביות בלבד
                        </button>
                    </div>
                </div>

                <!-- איכות (דינמי בהתאם לבחירה) -->
                <div class="space-y-2" id="quality-section">
                    <label id="quality-label" for="quality-select" class="block text-sm font-medium text-zinc-300">רמת איכות הוידאו:</label>
                    <select id="quality-select" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3.5 text-zinc-100 focus:outline-none focus:border-emerald-500 transition">
                        <!-- אפשרויות לוידאו כברירת מחדל -->
                        <option value="best">האיכות המרבית הזמינה (Best Quality)</option>
                        <option value="1080p">FHD (1080p) - דורש FFmpeg</option>
                        <option value="720p">HD (720p)</option>
                        <option value="480p">חיסכון במקום (480p)</option>
                    </select>
                </div>
            </div>

            <!-- הגדרות כתוביות מתקדמות -->
            <div id="subtitles-section" class="bg-zinc-950/40 p-4 border border-zinc-800/80 rounded-xl mb-6 space-y-3">
                <div class="flex items-center gap-3">
                    <input type="checkbox" id="download-subtitles-check" onchange="toggleSubSelect()" class="w-4 h-4 text-emerald-500 bg-zinc-900 border-zinc-700 rounded focus:ring-emerald-500">
                    <label for="download-subtitles-check" class="text-sm font-medium text-zinc-300 cursor-pointer">אני רוצה להוריד גם כתוביות לסרטון (קובץ .srt נפרד)</label>
                </div>
                <div id="sub-language-wrapper" class="hidden pl-7 space-y-1">
                    <label for="subtitle-lang-select" class="block text-xs text-zinc-500">בחר שפת כתוביות מתוך הרשימה:</label>
                    <select id="subtitle-lang-select" class="w-full md:w-64 bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-100 text-sm focus:outline-none focus:border-emerald-500 transition">
                        <option value="he">עברית (Hebrew)</option>
                        <option value="en" selected>אנגלית (English)</option>
                    </select>
                </div>
            </div>

            <!-- כפתור הפעלה ראשי -->
            <button id="download-btn" onclick="startDownload()" 
                    class="w-full py-4 bg-gradient-to-r from-emerald-500 to-teal-500 text-zinc-950 font-bold rounded-xl text-lg shadow-lg hover:from-emerald-400 hover:to-teal-400 transition transform hover:-translate-y-0.5 active:translate-y-0">
                🚀 התחל הורדה למחשב
            </button>

            <!-- אזור התקדמות דינמי (נסתר כברירת מחדל) -->
            <div id="progress-card" class="hidden mt-8 pt-6 border-t border-zinc-800/80 space-y-4">
                <div class="flex items-start gap-4">
                    <img id="status-thumbnail" src="" onerror="this.src='https://images.unsplash.com/photo-1518495973542-4542c06a5843?w=120&auto=format&fit=crop'" class="w-24 h-16 object-cover rounded-lg border border-zinc-800 shadow-md">
                    <div class="flex-1 min-w-0">
                        <h4 id="status-title" class="font-bold text-zinc-200 truncate text-sm md:text-base">שם הסרטון...</h4>
                        <p id="status-badge" class="inline-block px-2 py-0.5 text-xs font-semibold rounded mt-1 bg-amber-500/10 text-amber-400">מתחבר...</p>
                        <div class="flex gap-4 text-xs text-zinc-500 mt-2">
                            <span>מהירות: <strong id="speed-val" class="text-zinc-300">0 KB/s</strong></span>
                            <span>זמן נותר: <strong id="eta-val" class="text-zinc-300">00:00</strong></span>
                        </div>
                    </div>
                </div>

                <!-- בר התקדמות -->
                <div class="space-y-1">
                    <div class="flex justify-between text-xs text-zinc-400 font-medium">
                        <span>קצב התקדמות</span>
                        <span id="percent-val">0%</span>
                    </div>
                    <div class="w-full bg-zinc-950 rounded-full h-3 overflow-hidden border border-zinc-800">
                        <div id="progress-bar" class="bg-gradient-to-r from-emerald-500 to-teal-400 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <!-- תיבת שגיאה -->
            <div id="error-card" class="hidden mt-6 p-4 bg-red-950/30 border border-red-900/50 rounded-xl text-red-400 text-sm">
                <strong>אופס, אירעה שגיאה:</strong> <span id="error-text">פירוט השגיאה כאן</span>
            </div>

            <!-- תיבת הצלחה -->
            <div id="success-card" class="hidden mt-6 p-4 bg-emerald-950/30 border border-emerald-900/50 rounded-xl text-emerald-400 text-sm text-center">
                🎉 <strong>ההורדה הסתיימה בהצלחה!</strong> הקובץ מחכה לך בתיקיית ה-<b>Downloads</b> שלך במחשב.
            </div>
        </div>
    </main>

    <!-- פוטר מידע -->
    <footer class="py-6 border-t border-zinc-900 bg-zinc-950 text-center text-xs text-zinc-600">
        נתיב הורדה נוכחי במחשב שלך: <code class="bg-zinc-900 px-2 py-1 rounded text-zinc-400">C:\Users\meira\Downloads</code>
    </footer>

    <script>
        // ==========================================
        // מנגנון סימולציה מובנה (Mocking Backend APIs)
        // ==========================================
        let mockStatus = {
            status: "idle",
            percent: 0,
            speed: "0 KB/s",
            eta: "00:00",
            title: "",
            thumbnail: "",
            error_message: "",
            ffmpeg_installed: true
        };

        let mockInterval = null;

        // דריסת פונקציית fetch המובנית של הדפדפן כדי לדמות את שרת הפייתון
        const originalFetch = window.fetch;
        window.fetch = async function (url, options) {
            if (url === '/api/status') {
                return new Response(JSON.stringify(mockStatus), {
                    headers: { 'Content-Type': 'application/json' }
                });
            }

            if (url === '/api/info') {
                const body = JSON.parse(options.body);
                await new Promise(resolve => setTimeout(resolve, 1000)); // השהיית רשת קלה
                
                let title = "Lofi Hip Hop Radio 🌌 Beats to Relax/Study to [5 Hours]";
                let thumb = "https://images.unsplash.com/photo-1518495973542-4542c06a5843?w=500&auto=format&fit=crop";
                
                if (body.url.includes("eJ7V1svykpY")) {
                    title = "Lofi Chill Beats 🎧 Music for Studying, Working, Coding";
                    thumb = "https://images.unsplash.com/photo-1501386761578-eac5c94b800a?w=500&auto=format&fit=crop";
                }

                return new Response(JSON.stringify({
                    success: true,
                    title: title,
                    thumbnail: thumb,
                    duration: 18000, // 5 שעות בשניות
                    subtitles: ["he", "en", "es", "ja", "ru"]
                }), {
                    headers: { 'Content-Type': 'application/json' }
                });
            }

            if (url === '/api/download') {
                const body = JSON.parse(options.body);
                startSimulatedDownload(body);
                return new Response(JSON.stringify({ success: true }), {
                    headers: { 'Content-Type': 'application/json' }
                });
            }

            return originalFetch(url, options);
        };

        // סימולציה של שלבי ההורדה באחוזים ובמהירות משתנה
        function startSimulatedDownload(params) {
            mockStatus.status = "fetching";
            mockStatus.percent = 0;
            mockStatus.speed = "0 KB/s";
            mockStatus.eta = "מנתח...";
            mockStatus.title = document.getElementById('preview-title').innerText;
            mockStatus.thumbnail = document.getElementById('preview-thumb').src;

            if (mockInterval) clearInterval(mockInterval);

            let counter = 0;
            mockInterval = setInterval(() => {
                counter++;
                
                if (counter < 3) {
                    mockStatus.status = "fetching";
                } else if (counter < 25) {
                    mockStatus.status = "downloading";
                    mockStatus.percent = Math.min(100, Math.round((counter - 3) * 4.5));
                    // דימוי מהירות הורדה ממוצעת מציאותית
                    let speedMb = (15 + Math.random() * 5).toFixed(1);
                    mockStatus.speed = `${speedMb} MB/s`;
                    let remainingSecs = Math.max(1, Math.round((25 - counter) * 0.8));
                    mockStatus.eta = `00:0${remainingSecs}`;
                } else if (counter < 28) {
                    mockStatus.status = "converting";
                    mockStatus.percent = 100;
                    mockStatus.speed = "0 KB/s";
                    mockStatus.eta = "00:00";
                } else {
                    mockStatus.status = "finished";
                    clearInterval(mockInterval);
                }
            }, 500);
        }

        // ==========================================
        // לוגיקה מקורית של ה-UI (זהה לחלוטין לסקריפט הפייתון)
        // ==========================================
        let selectedFormat = 'mp4';
        let pollInterval = null;
        let lastFetchedUrl = '';

        window.addEventListener('load', async () => {
            try {
                const response = await fetch('/api/status');
                const data = await response.json();
                if (!data.ffmpeg_installed) {
                    document.getElementById('ffmpeg-warning').classList.remove('hidden');
                }
            } catch (err) {
                console.error("נכשלה בדיקת סטטוס מערכת", err);
            }
        });

        async function fetchVideoInfo() {
            const urlInput = document.getElementById('url-input').value.trim();
            if (!urlInput || urlInput === lastFetchedUrl) return;
            
            lastFetchedUrl = urlInput;
            
            const previewCard = document.getElementById('video-preview-card');
            const previewTitle = document.getElementById('preview-title');
            const previewThumb = document.getElementById('preview-thumb');
            const previewDuration = document.getElementById('preview-duration');
            const subLangSelect = document.getElementById('subtitle-lang-select');

            previewCard.classList.remove('hidden');
            previewTitle.innerText = "מנתח קישור... נא להמתין ⏳";
            previewThumb.src = "https://images.unsplash.com/photo-1518495973542-4542c06a5843?w=120&auto=format&fit=crop";

            try {
                const response = await fetch('/api/info', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url: urlInput })
                });
                const data = await response.json();

                if (data.success) {
                    previewTitle.innerText = data.title;
                    previewThumb.src = data.thumbnail;
                    
                    const mins = Math.floor(data.duration / 60);
                    const secs = data.duration % 60;
                    previewDuration.innerText = `אורך: ${mins}:${secs < 10 ? '0' : ''}${secs} דקות`;

                    if (data.subtitles && data.subtitles.length > 0) {
                        subLangSelect.innerHTML = '';
                        data.subtitles.forEach(lang => {
                            const option = document.createElement('option');
                            option.value = lang;
                            option.innerText = lang.toUpperCase();
                            if (lang === 'he' || lang === 'iw') option.selected = true;
                            subLangSelect.appendChild(option);
                        });
                    } else {
                        subLangSelect.innerHTML = '<option value="">אין כתוביות זמינות</option>';
                    }
                } else {
                    previewTitle.innerText = "שגיאה בניתוח הקישור. ודא שהוא תקין.";
                }
            } catch (err) {
                previewTitle.innerText = "שגיאת תקשורת קלה בחיבור לשרת";
            }
        }

        function setFormat(format) {
            selectedFormat = format;
            const mp4Btn = document.getElementById('type-mp4');
            const mp3Btn = document.getElementById('type-mp3');
            const subsBtn = document.getElementById('type-subs');
            
            const qualitySec = document.getElementById('quality-section');
            const qualityLabel = document.getElementById('quality-label');
            const qualitySelect = document.getElementById('quality-select');
            
            const subtitlesCheck = document.getElementById('download-subtitles-check');

            [mp4Btn, mp3Btn, subsBtn].forEach(btn => {
                btn.className = "py-3 px-3 rounded-xl border border-zinc-800 bg-zinc-950 text-zinc-400 font-semibold text-xs md:text-sm text-center transition hover:bg-zinc-900";
            });

            if (format === 'mp4') {
                mp4Btn.className = "py-3 px-3 rounded-xl border border-emerald-500 bg-emerald-500/10 text-emerald-400 font-semibold text-xs md:text-sm text-center transition hover:bg-emerald-500/20";
                qualitySec.style.opacity = "1";
                qualitySec.style.pointerEvents = "auto";
                qualityLabel.innerText = "רמת איכות הוידאו:";
                qualitySelect.innerHTML = `
                    <option value="best">האיכות המרבית הזמינה (Best Quality)</option>
                    <option value="1080p">FHD (1080p) - דורש FFmpeg</option>
                    <option value="720p">HD (720p)</option>
                    <option value="480p">חיסכון במקום (480p)</option>
                `;
            } else if (format === 'mp3') {
                mp3Btn.className = "py-3 px-3 rounded-xl border border-emerald-500 bg-emerald-500/10 text-emerald-400 font-semibold text-xs md:text-sm text-center transition hover:bg-emerald-500/20";
                qualitySec.style.opacity = "1";
                qualitySec.style.pointerEvents = "auto";
                qualityLabel.innerText = "איכות השמע (Bitrate):";
                qualitySelect.innerHTML = `
                    <option value="320">איכות אולפן גבוהה (320kbps)</option>
                    <option value="192" selected>איכות סטנדרטית טובה (192kbps)</option>
                    <option value="128">איכות חיסכון במקום (128kbps)</option>
                `;
            } else if (format === 'subs_only') {
                subsBtn.className = "py-3 px-3 rounded-xl border border-emerald-500 bg-emerald-500/10 text-emerald-400 font-semibold text-xs md:text-sm text-center transition hover:bg-emerald-500/20";
                qualitySec.style.opacity = "0.3";
                qualitySec.style.pointerEvents = "none";
                subtitlesCheck.checked = true;
                toggleSubSelect();
            }
        }

        function toggleSubSelect() {
            const wrapper = document.getElementById('sub-language-wrapper');
            const isChecked = document.getElementById('download-subtitles-check').checked;
            if (isChecked) {
                wrapper.classList.remove('hidden');
            } else {
                wrapper.classList.add('hidden');
            }
        }

        async function startDownload() {
            const urlInput = document.getElementById('url-input').value.trim();
            if (!urlInput) {
                alert("אנא הכנס קישור תקין מיוטיוב");
                return;
            }

            document.getElementById('error-card').classList.add('hidden');
            document.getElementById('success-card').classList.add('hidden');
            document.getElementById('progress-card').classList.remove('hidden');
            document.getElementById('download-btn').disabled = true;
            document.getElementById('download-btn').innerText = "⏳ מעבד בקשה...";

            const quality = document.getElementById('quality-select').value;
            const downloadSubtitles = document.getElementById('download-subtitles-check').checked;
            const subtitleLang = document.getElementById('subtitle-lang-select').value;

            try {
                const response = await fetch('/api/download', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        url: urlInput,
                        type: selectedFormat,
                        quality: quality,
                        download_subtitles: downloadSubtitles || (selectedFormat === 'subs_only'),
                        subtitle_lang: subtitleLang
                    })
                });

                if (response.ok) {
                    if (pollInterval) clearInterval(pollInterval);
                    pollInterval = setInterval(checkStatus, 1000);
                } else {
                    showError("נכשל בהפעלת ההורדה מול השרת המקומי");
                }
            } catch (err) {
                showError("שגיאת תקשורת עם השרת: " + err.message);
            }
        }

        async function checkStatus() {
            try {
                const response = await fetch('/api/status');
                const data = await response.json();

                if (data.title) {
                    document.getElementById('status-title').innerText = data.title;
                }
                if (data.thumbnail) {
                    document.getElementById('status-thumbnail').src = data.thumbnail;
                }

                const percent = data.percent || 0;
                document.getElementById('percent-val').innerText = percent + "%";
                document.getElementById('progress-bar').style.width = percent + "%";
                document.getElementById('speed-val').innerText = data.speed || 'N/A';
                document.getElementById('eta-val').innerText = data.eta || '00:00';

                const statusBadge = document.getElementById('status-badge');
                if (data.status === 'fetching') {
                    statusBadge.innerText = '📡 מתחבר ליוטיוב ומנתח...';
                    statusBadge.className = "inline-block px-2 py-0.5 text-xs font-semibold rounded mt-1 bg-blue-500/10 text-blue-400";
                } else if (data.status === 'downloading') {
                    statusBadge.innerText = '⚡ מוריד...';
                    statusBadge.className = "inline-block px-2 py-0.5 text-xs font-semibold rounded mt-1 bg-amber-500/10 text-amber-400";
                } else if (data.status === 'converting') {
                    statusBadge.innerText = '⚙️ מעבד וממזג קבצים (נא להמתין)...';
                    statusBadge.className = "inline-block px-2 py-0.5 text-xs font-semibold rounded mt-1 bg-purple-500/10 text-purple-400";
                } else if (data.status === 'finished') {
                    statusBadge.innerText = '✅ הושלם!';
                    statusBadge.className = "inline-block px-2 py-0.5 text-xs font-semibold rounded mt-1 bg-emerald-500/10 text-emerald-400";
                    clearInterval(pollInterval);
                    document.getElementById('success-card').classList.remove('hidden');
                    resetBtn();
                } else if (data.status === 'error') {
                    clearInterval(pollInterval);
                    showError(data.error_message || "שגיאה לא ידועה במהלך ההורדה");
                    resetBtn();
                }

            } catch (err) {
                console.error("שגיאה בבדיקת הסטטוס:", err);
            }
        }

        function showError(msg) {
            document.getElementById('error-card').classList.remove('hidden');
            document.getElementById('error-text').innerText = msg;
            document.getElementById('progress-card').classList.add('hidden');
            resetBtn();
        }

        function resetBtn() {
            const btn = document.getElementById('download-btn');
            btn.disabled = false;
            btn.innerText = "🚀 התחל הורדה למחשב";
        }
    </script>
</body>
</html>
