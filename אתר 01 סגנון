<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>האתר שלי</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Heebo', sans-serif;
            scroll-behavior: smooth;
        }
        .hero-gradient {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800">

    <!-- ניווט -->
    <nav class="fixed w-full bg-white/90 backdrop-blur-md shadow-sm z-50">
        <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="text-2xl font-bold text-indigo-600">המותג שלי</div>
            <div class="hidden md:flex space-x-reverse space-x-8">
                <a href="#home" class="hover:text-indigo-600 transition">בית</a>
                <a href="#about" class="hover:text-indigo-600 transition">אודות</a>
                <a href="#services" class="hover:text-indigo-600 transition">שירותים</a>
                <a href="#contact" class="hover:text-indigo-600 transition">צור קשר</a>
            </div>
            <button class="md:hidden text-gray-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </div>
    </nav>

    <!-- אזור ראשי (Hero) -->
    <section id="home" class="hero-gradient min-h-screen flex items-center justify-center text-white pt-20">
        <div class="max-w-4xl mx-auto text-center px-4">
            <h1 class="text-5xl md:text-7xl font-bold mb-6">ברוכים הבאים לאתר החדש שלכם</h1>
            <p class="text-xl md:text-2xl mb-10 opacity-90">בניית חוויות דיגיטליות מרגשות עם דגש על עיצוב וביצועים.</p>
            <div class="flex flex-wrap justify-center gap-4">
                <a href="#services" class="bg-white text-indigo-600 px-8 py-3 rounded-full font-bold hover:bg-opacity-90 transition shadow-lg">השירותים שלנו</a>
                <a href="#contact" class="border-2 border-white px-8 py-3 rounded-full font-bold hover:bg-white hover:text-indigo-600 transition">דברו איתנו</a>
            </div>
        </div>
    </section>

    <!-- אודות -->
    <section id="about" class="py-20 px-4">
        <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">
            <div class="rounded-2xl overflow-hidden shadow-2xl">
                <img src="https://images.unsplash.com/photo-1497215728101-856f4ea42174?auto=format&fit=crop&w=800&q=80" alt="משרד מודרני" class="w-full h-full object-cover">
            </div>
            <div>
                <h2 class="text-3xl font-bold mb-6 text-indigo-900">קצת עלינו</h2>
                <p class="text-lg leading-relaxed mb-6">
                    אנחנו צוות יצירתי המוקדש לעזור לעסקים לצמוח במרחב הדיגיטלי. אנחנו משלבים טכנולוגיה מתקדמת עם עיצוב שובה לב כדי ליצור מוצרים שמשתמשים אוהבים.
                </p>
                <ul class="space-y-3">
                    <li class="flex items-center space-x-reverse space-x-3">
                        <span class="bg-indigo-100 p-1 rounded-full">✅</span>
                        <span>ניסיון של מעל 10 שנים</span>
                    </li>
                    <li class="flex items-center space-x-reverse space-x-3">
                        <span class="bg-indigo-100 p-1 rounded-full">✅</span>
                        <span>ליווי אישי לכל לקוח</span>
                    </li>
                    <li class="flex items-center space-x-reverse space-x-3">
                        <span class="bg-indigo-100 p-1 rounded-full">✅</span>
                        <span>תוצאות מוכחות בשטח</span>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- שירותים -->
    <section id="services" class="py-20 bg-gray-100 px-4">
        <div class="max-w-6xl mx-auto text-center">
            <h2 class="text-3xl font-bold mb-12 text-indigo-900">מה אנחנו מציעים</h2>
            <div class="grid md:grid-cols-3 gap-8">
                <!-- כרטיס שירות 1 -->
                <div class="bg-white p-8 rounded-xl shadow-md hover:shadow-xl transition transform hover:-translate-y-1">
                    <div class="text-4xl mb-4 text-indigo-500">💻</div>
                    <h3 class="text-xl font-bold mb-3">פיתוח אתרים</h3>
                    <p class="text-gray-600">אתרים מהירים, מותאמים לכל המכשירים וקלים לניהול.</p>
                </div>
                <!-- כרטיס שירות 2 -->
                <div class="bg-white p-8 rounded-xl shadow-md hover:shadow-xl transition transform hover:-translate-y-1">
                    <div class="text-4xl mb-4 text-indigo-500">🎨</div>
                    <h3 class="text-xl font-bold mb-3">עיצוב גרפי</h3>
                    <p class="text-gray-600">מיתוג ייחודי ועיצוב ממשק משתמש (UI/UX) מנצח.</p>
                </div>
                <!-- כרטיס שירות 3 -->
                <div class="bg-white p-8 rounded-xl shadow-md hover:shadow-xl transition transform hover:-translate-y-1">
                    <div class="text-4xl mb-4 text-indigo-500">📈</div>
                    <h3 class="text-xl font-bold mb-3">שיווק דיגיטלי</h3>
                    <p class="text-gray-600">קידום במנועי חיפוש וניהול קמפיינים ברשתות החברתיות.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- יצירת קשר -->
    <section id="contact" class="py-20 px-4">
        <div class="max-w-3xl mx-auto">
            <div class="bg-white rounded-2xl shadow-xl p-8 md:p-12">
                <h2 class="text-3xl font-bold mb-8 text-center text-indigo-900">בואו נדבר!</h2>
                <form id="contactForm" class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">שם מלא</label>
                        <input type="text" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">אימייל</label>
                        <input type="email" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">הודעה</label>
                        <textarea rows="4" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition"></textarea>
                    </div>
                    <button type="submit" class="w-full bg-indigo-600 text-white py-3 rounded-lg font-bold hover:bg-indigo-700 transition shadow-lg">שלח הודעה</button>
                </form>
                <div id="successMessage" class="hidden mt-6 p-4 bg-green-100 text-green-700 rounded-lg text-center">
                    ההודעה נשלחה בהצלחה! נחזור אליכם בהקדם.
                </div>
            </div>
        </div>
    </section>

    <!-- כותרת תחתונה -->
    <footer class="bg-gray-900 text-white py-12 px-4 text-center">
        <div class="mb-6 text-2xl font-bold">המותג שלי</div>
        <div class="flex justify-center space-x-reverse space-x-6 mb-8">
            <a href="#" class="hover:text-indigo-400 transition">פייסבוק</a>
            <a href="#" class="hover:text-indigo-400 transition">אינסטגרם</a>
            <a href="#" class="hover:text-indigo-400 transition">לינקדאין</a>
        </div>
        <p class="text-gray-500 text-sm">© 2024 כל הזכויות שמורות למותג שלי</p>
    </footer>

    <script>
        // פונקציונליות פשוטה לטופס
        document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();
            this.classList.add('hidden');
            document.getElementById('successMessage').classList.remove('hidden');
        });

        // סגירת תפריט בנייד (לוגיקה בסיסית)
        document.querySelectorAll('nav a').forEach(link => {
            link.addEventListener('click', () => {
                // כאן אפשר להוסיף סגירת תפריט המבורגר אם נבנה כזה מלא
            });
        });
    </script>
</body>
</html>
