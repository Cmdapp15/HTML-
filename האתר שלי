<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>מאיר רחמני | אתר אישי</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;700;900&family=Assistant:wght@300;400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Assistant', 'Heebo', sans-serif;
            scroll-behavior: smooth;
        }
        .text-gradient {
            background: linear-gradient(90deg, #1e3a8a, #3b82f6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero-bg {
            background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.8)), 
                        url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200&q=80');
            background-size: cover;
            background-position: center;
        }
        .card-hover:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 overflow-x-hidden">

    <!-- Navbar -->
    <nav class="fixed w-full bg-white/80 backdrop-blur-lg border-b border-slate-200 z-50">
        <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center">
            <div class="text-2xl font-black tracking-tighter text-blue-900">מאיר רחמני</div>
            <div class="hidden md:flex items-center space-x-reverse space-x-8 font-medium">
                <a href="#home" class="text-slate-600 hover:text-blue-600 transition">בית</a>
                <a href="#about" class="text-slate-600 hover:text-blue-600 transition">אודות</a>
                <a href="#portfolio" class="text-slate-600 hover:text-blue-600 transition">פרויקטים</a>
                <a href="#contact" class="bg-blue-600 text-white px-6 py-2 rounded-full hover:bg-blue-700 transition shadow-md">צרו קשר</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="hero-bg min-h-screen flex items-center relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 pt-20 w-full relative z-10">
            <div class="max-w-2xl text-white">
                <span class="inline-block px-4 py-1 bg-blue-600/30 border border-blue-400/30 rounded-full text-blue-400 text-sm font-bold mb-6">זמין לפרויקטים חדשים</span>
                <h1 class="text-6xl md:text-8xl font-black mb-6 leading-tight">מאיר רחמני</h1>
                <p class="text-xl md:text-2xl text-slate-300 mb-10 leading-relaxed">
                    יוצר פתרונות דיגיטליים מתקדמים, מעצב חוויות משתמש ייחודיות ובונה אתרים שמעוררים השראה.
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="#portfolio" class="bg-blue-600 text-white px-10 py-4 rounded-xl font-bold text-center hover:bg-blue-700 transition-all shadow-xl shadow-blue-600/20">צפייה בתיק העבודות</a>
                    <a href="#about" class="bg-white/10 backdrop-blur-md border border-white/20 text-white px-10 py-4 rounded-xl font-bold text-center hover:bg-white/20 transition-all">מי אני?</a>
                </div>
            </div>
        </div>
        <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
        </div>
    </section>

    <!-- Stats/Logos -->
    <div class="bg-white py-12 border-b border-slate-100">
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
            <div>
                <div class="text-4xl font-bold text-blue-600">+50</div>
                <div class="text-slate-500 text-sm">פרויקטים מוצלחים</div>
            </div>
            <div>
                <div class="text-4xl font-bold text-blue-600">+100</div>
                <div class="text-slate-500 text-sm">לקוחות מרוצים</div>
            </div>
            <div>
                <div class="text-4xl font-bold text-blue-600">100%</div>
                <div class="text-slate-500 text-sm">דיוק בלוחות זמנים</div>
            </div>
            <div>
                <div class="text-4xl font-bold text-blue-600">24/7</div>
                <div class="text-slate-500 text-sm">תמיכה ושירות</div>
            </div>
        </div>
    </div>

    <!-- About Me -->
    <section id="about" class="py-24 px-6 bg-slate-50">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
            <div class="relative group">
                <div class="absolute -inset-4 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-2xl blur opacity-25 group-hover:opacity-40 transition duration-1000"></div>
                <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&w=800&q=80" alt="מאיר רחמני בעבודה" class="relative rounded-2xl shadow-2xl grayscale hover:grayscale-0 transition duration-500 object-cover w-full h-[500px]">
            </div>
            <div>
                <h2 class="text-blue-600 font-bold tracking-widest uppercase text-sm mb-4">הסיפור שלי</h2>
                <h3 class="text-4xl md:text-5xl font-black text-slate-900 mb-8 leading-tight">אני מאיר רחמני, מומחה לפיתוח ועיצוב דיגיטלי.</h3>
                <p class="text-lg text-slate-600 mb-6 leading-relaxed">
                    עם תשוקה בלתי נגמרת לעולם הטכנולוגי, אני עוזר לעסקים ויזמים להפוך רעיונות מורכבים למציאות דיגיטלית פשוטה ואסתטית. המטרה שלי היא תמיד לספק מוצר שהוא לא רק יפה, אלא גם פונקציונלי ומניע לפעולה.
                </p>
                <div class="space-y-4 mb-8 text-slate-700">
                    <div class="flex items-center space-x-reverse space-x-3">
                        <div class="w-6 h-6 bg-blue-100 rounded-full flex items-center justify-center text-blue-600">✓</div>
                        <span class="font-medium">תכנון אסטרטגי ומחקר משתמשים</span>
                    </div>
                    <div class="flex items-center space-x-reverse space-x-3">
                        <div class="w-6 h-6 bg-blue-100 rounded-full flex items-center justify-center text-blue-600">✓</div>
                        <span class="font-medium">עיצוב UI/UX מותאם אישית</span>
                    </div>
                    <div class="flex items-center space-x-reverse space-x-3">
                        <div class="w-6 h-6 bg-blue-100 rounded-full flex items-center justify-center text-blue-600">✓</div>
                        <span class="font-medium">פיתוח קוד נקי ואופטימיזציה מלאה</span>
                    </div>
                </div>
                <button class="text-blue-600 font-bold border-b-2 border-blue-600 pb-1 hover:text-blue-800 hover:border-blue-800 transition">קראו עוד עלי</button>
            </div>
        </div>
    </section>

    <!-- Portfolio Section -->
    <section id="portfolio" class="py-24 px-6 bg-white">
        <div class="max-w-7xl mx-auto text-center mb-16">
            <h2 class="text-4xl font-black text-slate-900 mb-4">פרויקטים נבחרים</h2>
            <p class="text-slate-500 max-w-2xl mx-auto">מבט על העבודות האחרונות שלי, שבהן השקעתי את כל הידע והיצירתיות שלי.</p>
        </div>
        <div class="max-w-7xl mx-auto grid md:grid-cols-3 gap-8">
            <!-- Project 1 -->
            <div class="group card-hover transition-all duration-300">
                <div class="relative overflow-hidden rounded-2xl mb-4 h-64 shadow-lg">
                    <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80" alt="פרויקט 1" class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
                    <div class="absolute inset-0 bg-blue-900/40 opacity-0 group-hover:opacity-100 transition duration-500 flex items-center justify-center">
                        <span class="bg-white text-blue-900 px-6 py-2 rounded-full font-bold">צפייה בפרויקט</span>
                    </div>
                </div>
                <h4 class="text-xl font-bold text-slate-900">פלטפורמת מסחר מתקדמת</h4>
                <p class="text-slate-500 text-sm">עיצוב חנות מקוונת עם דגש על חוויית קנייה מהירה.</p>
            </div>
            <!-- Project 2 -->
            <div class="group card-hover transition-all duration-300">
                <div class="relative overflow-hidden rounded-2xl mb-4 h-64 shadow-lg">
                    <img src="https://images.unsplash.com/photo-1486312338219-ce68d2c6f44d?auto=format&fit=crop&w=800&q=80" alt="פרויקט 2" class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
                    <div class="absolute inset-0 bg-blue-900/40 opacity-0 group-hover:opacity-100 transition duration-500 flex items-center justify-center">
                        <span class="bg-white text-blue-900 px-6 py-2 rounded-full font-bold">צפייה בפרויקט</span>
                    </div>
                </div>
                <h4 class="text-xl font-bold text-slate-900">אתר תדמית לחברת הייטק</h4>
                <p class="text-slate-500 text-sm">בניית אתר רספונסיבי מבוסס ביצועים גבוהים.</p>
            </div>
            <!-- Project 3 -->
            <div class="group card-hover transition-all duration-300">
                <div class="relative overflow-hidden rounded-2xl mb-4 h-64 shadow-lg">
                    <img src="https://images.unsplash.com/photo-1551288049-bbbda536339a?auto=format&fit=crop&w=800&q=80" alt="פרויקט 3" class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
                    <div class="absolute inset-0 bg-blue-900/40 opacity-0 group-hover:opacity-100 transition duration-500 flex items-center justify-center">
                        <span class="bg-white text-blue-900 px-6 py-2 rounded-full font-bold">צפייה בפרויקט</span>
                    </div>
                </div>
                <h4 class="text-xl font-bold text-slate-900">אפליקציית ניהול משימות</h4>
                <p class="text-slate-500 text-sm">תכנון ועיצוב ממשק משתמש לאפליקציית SaaS.</p>
            </div>
        </div>
    </section>

    <!-- Contact Form -->
    <section id="contact" class="py-24 px-6 bg-slate-900 text-white">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16">
            <div>
                <h2 class="text-5xl font-black mb-6">בואו נבנה משהו גדול ביחד.</h2>
                <p class="text-slate-400 text-xl mb-10 leading-relaxed">
                    זקוקים לייעוץ, מעוניינים להתחיל פרויקט או סתם רוצים להגיד שלום? אני זמין לשיחה.
                </p>
                <div class="space-y-6">
                    <div class="flex items-center space-x-reverse space-x-4">
                        <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center text-xl">📧</div>
                        <div>
                            <div class="text-slate-400 text-sm font-medium">כתובת אימייל</div>
                            <div class="text-lg font-bold">meirachmani@gmail.com</div>
                        </div>
                    </div>
                    <div class="flex items-center space-x-reverse space-x-4">
                        <div class="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center text-xl">📞</div>
                        <div>
                            <div class="text-slate-400 text-sm font-medium">טלפון</div>
                            <div class="text-lg font-bold">0587764117</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-white text-slate-900 p-8 md:p-12 rounded-3xl shadow-2xl">
                <form id="contactForm" class="space-y-6">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-bold mb-2">שם מלא</label>
                            <input type="text" placeholder="מאיר רחמני" required class="w-full px-4 py-4 rounded-xl border border-slate-200 focus:ring-2 focus:ring-blue-600 outline-none">
                        </div>
                        <div>
                            <label class="block text-sm font-bold mb-2">אימייל</label>
                            <input type="email" placeholder="meirachmani@gmail.com" required class="w-full px-4 py-4 rounded-xl border border-slate-200 focus:ring-2 focus:ring-blue-600 outline-none">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-bold mb-2">נושא הפנייה</label>
                        <select class="w-full px-4 py-4 rounded-xl border border-slate-200 focus:ring-2 focus:ring-blue-600 outline-none">
                            <option>פרויקט חדש</option>
                            <option>ייעוץ עסקי</option>
                            <option>אחר</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-bold mb-2">הודעה</label>
                        <textarea rows="4" placeholder="איך אני יכול לעזור לכם?" required class="w-full px-4 py-4 rounded-xl border border-slate-200 focus:ring-2 focus:ring-blue-600 outline-none"></textarea>
                    </div>
                    <button type="submit" class="w-full bg-blue-600 text-white py-4 rounded-xl font-black text-lg hover:bg-blue-700 transition-all shadow-xl shadow-blue-600/30">שלח הודעה עכשיו</button>
                </form>
                <div id="msg" class="hidden mt-6 text-center text-green-600 font-bold bg-green-50 p-4 rounded-xl border border-green-100">
                    תודה, מאיר רחמני קיבל את ההודעה שלכם! נחזור אליכם בהקדם.
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="py-12 px-6 border-t border-slate-100 bg-white">
        <div class="max-w-7xl mx-auto flex flex-col md:row justify-between items-center text-center md:text-right">
            <div class="text-2xl font-black text-blue-900 mb-4 md:mb-0">מאיר רחמני</div>
            <div class="text-slate-500 text-sm">
                &copy; 2024 מאיר רחמני. כל הזכויות שמורות. נבנה עבורך בסטנדרט הגבוה ביותר.
            </div>
            <div class="flex space-x-reverse space-x-6 mt-6 md:mt-0">
                <a href="#" class="text-slate-400 hover:text-blue-600 transition">LinkedIn</a>
                <a href="#" class="text-slate-400 hover:text-blue-600 transition">Instagram</a>
                <a href="#" class="text-slate-400 hover:text-blue-600 transition">WhatsApp</a>
            </div>
        </div>
    </footer>

    <script>
        // פונקציונליות טופס
        const form = document.getElementById('contactForm');
        const msg = document.getElementById('msg');
        
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            form.style.display = 'none';
            msg.style.display = 'block';
        });

        // אנימציית הופעה חלקה (אופציונלי)
        window.addEventListener('scroll', () => {
            const navbar = document.querySelector('nav');
            if (window.scrollY > 100) {
                navbar.classList.add('shadow-xl');
            } else {
                navbar.classList.remove('shadow-xl');
            }
        });
    </script>
</body>
</html>
